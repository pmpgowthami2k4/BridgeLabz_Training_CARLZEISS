{
    "Routes": [
        {
            "DownstreamPathTemplate": "/api/User/register",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "userservice",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/gateway/user/register",
            "UpstreamHttpMethod": [ "POST" ]
        },
        {
            "DownstreamPathTemplate": "/api/User/login",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "userservice",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/gateway/user/login",
            "UpstreamHttpMethod": [ "POST" ]
        },
        {
            "DownstreamPathTemplate": "/api/User/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "userservice",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/gateway/user/{everything}",
            "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ]
        },

        {
            "DownstreamPathTemplate": "/api/Notes/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "notesservice",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/gateway/notes/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
        },

        {
            "DownstreamPathTemplate": "/api/Label/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "labelservice",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/gateway/label/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
        },

        {
            "DownstreamPathTemplate": "/api/Collaborator/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "collaboratorservice",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/gateway/collaborator/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
            "AuthenticationOptions": {
                "AuthenticationProviderKey": "Bearer"
            }
        }
    ],

    "GlobalConfiguration": {
        "BaseUrl": "http://localhost:7000"
    }
}